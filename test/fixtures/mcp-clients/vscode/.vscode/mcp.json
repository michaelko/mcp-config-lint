{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@microsoft/mcp-server-playwright"]
    },
    "sandboxed": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@example/mcp-server@1.2.3"],
      "sandboxEnabled": true
    }
  }
}
